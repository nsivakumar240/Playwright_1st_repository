
{
    "default": {
        "tags": "@method22",
        "dryRun": false,
        "formatOptions": {
            "snippetInterface": "async-await",
            "resultsDir": "allure-results"
        },
        "paths": [
            "PlaywrightAutocode/FeatureFile/**/*.feature"
        ],
        "require": [
            "PlaywrightAutocode/StepDefinition/**/*.ts",
            "PlaywrightAutocode/StepDefinition/**/*.js"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "format": [
            "progress-bar",
            "html:test-result/cucumber-report.html",
            "json:test-result/cucumber-report.json",
            "junit:test-result/junit.xml",
            "rerun:@rerun.txt",
            "allure-cucumberjs/reporter"
        ],
        "parallel": 1
    }
}
