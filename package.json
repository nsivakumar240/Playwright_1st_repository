{
  "name": "playwrightproject",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js --config cucumber.json",
    "test:allure": "npm run test && allure generate allure-results --clean -o allure-report && python3 -m http.server 8000 --directory allure-report",
    "test:windows": "cucumber-js PlaywrightAutocode/FeatureFile/WaitsAndWindowsHandling.feature --config cucumber.json --format progress"
  },
  "keywords": [
    "pw",
    "ts",
    "js"
  ],
  "author": "Quality",
  "type": "commonjs",
  "license": "ISC",
  "description": "this is a playwright automation project",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/messages": "^34.2.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "allure-js-commons": "^3.14.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^18.0.9",
    "playwright": "^1.64.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
